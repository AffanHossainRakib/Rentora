{
  "name": "rentora",
  "version": "1.0.0",
  "description": "Discover and List Rental Properties Effortlessly",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "deploy": "npm run build && vercel --prod",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "stripe:webhook": "stripe listen --forward-to localhost:5000/api/v1/payments/webhook"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AffanHossainRakib/Rentora.git"
  },
  "keywords": [
    "rental",
    "property",
    "real estate",
    "listing",
    "discovery",
    "rentora"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AffanHossainRakib/Rentora/issues"
  },
  "homepage": "https://github.com/AffanHossainRakib/Rentora#readme",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  }
}
