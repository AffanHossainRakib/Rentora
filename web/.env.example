# The deployed API. Note it must be https:// — the http:// form in the docs
# 308-redirects, which costs a round trip on every request.
NEXT_PUBLIC_API_BASE_URL=https://api.rentora.itsaffan.com/api/v1

# Running the backend locally instead? Use whatever port it binds to.
# Avoid port 5000 on macOS: AirPlay Receiver owns it and answers every
# request with "403 Forbidden" from Server: AirTunes, which looks exactly
# like an auth failure. Disable it in System Settings > General >
# AirDrop & Handoff, or bind the API elsewhere.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
